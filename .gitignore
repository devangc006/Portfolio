# ==============================================================================
# Git Ignore Configuration
# Project: Portfolio (React 19 + Vite + Tailwind CSS + Oxlint)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEPENDENCIES & PACKAGE MANAGERS
# ------------------------------------------------------------------------------
# Installed dependencies - reproducible via `npm install` or equivalent.
# Never commit these: they are large, platform-specific, and clutter the repository.
node_modules/

# Yarn Plug'n'Play (PnP) artifacts
.pnp
.pnp.js
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------------------------------------------
# 2. BUILD ARTIFACTS & PRODUCTION BUNDLES
# ------------------------------------------------------------------------------
# Production build outputs generated by `npm run build` (Vite)
dist/
dist-ssr/

# Generic compilation outputs from static generators or alternative bundlers
build/
out/

# TypeScript incremental build cache
*.tsbuildinfo

# Local development overrides
*.local

# ------------------------------------------------------------------------------
# 3. COMPILER & LINTER CACHES
# ------------------------------------------------------------------------------
# Vite dependency pre-bundling cache
.vite/

# Generic tooling & bundler cache
.cache/
.parcel-cache/

# Linter caches (Oxlint / ESLint / Stylelint)
.oxlint-cache
.eslintcache
.stylelintcache

# Monorepo / build pipeline cache
.turbo/

# ------------------------------------------------------------------------------
# 4. ENVIRONMENT VARIABLES & SECRETS
# ------------------------------------------------------------------------------
# Sensitive configuration files containing API keys, credentials, or private URLs.
# NEVER commit credentials to version control.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local

# Explicitly allow committing template/sample environment files (safe for git)
!.env.example
!.env.sample

# ------------------------------------------------------------------------------
# 5. DIAGNOSTICS & LOGS
# ------------------------------------------------------------------------------
# Standard runtime error and log files
logs/
*.log

# Package manager debug traces created when installations fail
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 6. TESTING & CODE COVERAGE
# ------------------------------------------------------------------------------
# Test runner output and coverage reports (e.g., Vitest, Jest, Playwright)
coverage/
*.lcov
.nyc_output/

# ------------------------------------------------------------------------------
# 7. CODE EDITORS & IDES
# ------------------------------------------------------------------------------
# JetBrains IDEs (WebStorm, IntelliJ IDEA, etc.)
.idea/

# Visual Studio Code workspace state
# Ignores user-specific workspace state while preserving team extension recommendations
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Sublime Text workspace & project state
*.sublime-project
*.sublime-workspace

# Visual Studio files
*.suo
*.ntvs*
*.njsproj
*.sln

# Vim / Nano temporary swap and backup files
*.sw?
*.swo
*.swp
*.bak
*~

# ------------------------------------------------------------------------------
# 8. OPERATING SYSTEM ARTIFACTS
# ------------------------------------------------------------------------------
# macOS: Folder attributes, icon cache, spotlight metadata, and trash bins
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows: Folder icon caches, desktop layout files, and recycle bins
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux: Desktop entry files and trash directories
.directory
.fuse_hidden*
.Trash-*

# ------------------------------------------------------------------------------
# 9. HOSTING & DEPLOYMENT PLATFORMS
# ------------------------------------------------------------------------------
# CLI state and preview metadata from deployment providers
.vercel/
.netlify/
